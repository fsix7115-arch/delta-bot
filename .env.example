# =============================================================================
# Delta Exchange API credentials — FILL THESE IN, THEN RENAME TO .env
# =============================================================================
# 1. Go to https://testnet.delta.exchange (TESTNET first, never prod)
# 2. Settings -> Create API Key
# 3. Enable READ permission only to start. Do NOT enable Trading yet.
# 4. Whitelist this machine's IP if the key requires it.
# 5. Copy .env.example to .env and paste your values.
# 6. chmod 600 .env
#
# The bot reads these; nothing else does. Never paste the key in Telegram.

DELTA_API_KEY=
DELTA_API_SECRET=

# Testnet India (safe — no real money)
DELTA_BASE_URL=https://cdn-ind.testnet.deltaex.org
# Production India (REAL MONEY — do not switch until paper trading is proven)
# DELTA_BASE_URL=https://api.india.delta.exchange

# --- risk limits (a guardrail, not a suggestion) ---
DELTA_MAX_RISK_PCT=0.5
DELTA_MAX_DAILY_LOSS_PCT=2.0
DELTA_REQUIRE_APPROVAL=true
